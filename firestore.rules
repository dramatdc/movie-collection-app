rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /movies/{movieId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /wishlist/{tmdbId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /lists/{listId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /items/{tmdbId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared UPC -> product title cache. Not personal data; kept public
    // read/write so the server route can populate it without admin creds.
    match /upc_cache/{upc} {
      allow read, write: if true;
    }
  }
}
