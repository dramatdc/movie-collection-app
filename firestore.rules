rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything under /users/{uid} is private to that one signed-in user.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /movies/{movieId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /wishlist/{tmdbId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /watchlist/{tmdbId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /lists/{listId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /items/{itemId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Not actively used by any feature yet — only ever touched by the
      // account-deletion cleanup, in case a future settings feature writes
      // here. Harmless to include now.
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared barcode -> title cache, looked up by the /api/upc route.
    // That route has no auth check of its own, so this must stay open —
    // it holds no personal data, just UPC codes and product titles.
    match /upc_cache/{upc} {
      allow read, write: if true;
    }
  }
}
